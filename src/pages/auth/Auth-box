.auth-box {
  background: #fff;
  padding: 1.5rem 1.2rem 1.2rem 1.2rem;
  border-radius: 16px;
  box-shadow: 0 4px 24px 0 rgb(91 33 182 / 0.10), 0 1.5px 8px 0 rgb(0 0 0 / 0.04);
  border: 1.5px solid #ececec;
  width: 60vw;
  min-width: 280px;
  height: 70vh;
  min-height: 400px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  position: relative;
  box-sizing: border-box;
  overflow: auto;
} 